$relative-path: "<%= relativePaths.root.toSpriteDir %>" !default;

:root {
<% if (useRootVariables) { -%>
<% if (dimensions) { -%>
  --<%= prefix %>-height: <%= dimensions.height %>;
  --<%= prefix %>-width: <%= dimensions.width %>;
<% } -%>
<% icons.forEach(function(icon, id) { -%>
  --<%= prefix %>-<%= id %>-url: url(#{ $relative-path + '<%= spriteFileName %>#<%= id %>' });
<% if (!dimensions && defineDimensionsInRootVariables) { -%>
  --<%= prefix %>-<%= id %>-height: <%= icon.height %>px;
  --<%= prefix %>-<%= id %>-width: <%= icon.width %>px;
<% } -%>
<% }); -%>
<% } -%>
}
