@use "<%= settingsRelativePath %>";
<% if (includeRootInMainFile) { -%>
@use "<%= rootRelativePath %>";
<% } -%>

.#{<%= settingsBasename %>.$<%= prefix %>-base-class} {
  background-repeat: no-repeat;
  display: inline-block;
  overflow: hidden;
  text-indent: 200%;
  white-space: nowrap;
}

<% if (useRootVariables && !defineDimensionsInClasses) { -%>
@each $id in $<%= prefix %>--names {
  .#{$id} {
    background-image: var(#{'--' + $id + '-url'});
  }
}
<% } else { -%>
<% icons.forEach(function(icon, id) { -%>
.#{<%= settingsBasename %>.$<%= prefix %>-prefix}<%= id %> {
<% if (useRootVariables) { -%>
  background-image: var(--<%= prefix %>-<%= id %>-url);
<% } else { -%>
  background-image: url($relative-path + '<%= spriteFileName %>#<%= id %>');
<% } -%>
<% if (defineDimensionsInClasses) { -%>
  height: <%= icon.height %>px;
  width: <%= icon.width %>px;
<% } -%>
}
<% }); %>
<% } -%>
